# Configure only for the new dedicated Infinity Growth Tech Supabase project.
# Keep the secret key in Vercel server-side environment variables. Never use NEXT_PUBLIC_.
SUPABASE_URL=https://your-igt-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Create a Cloudflare Turnstile widget and use approved production and preview domains.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me
TURNSTILE_ALLOWED_HOSTNAMES=infinitygrowthtech.com,www.infinitygrowthtech.com
